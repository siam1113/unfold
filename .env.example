# Auth0 Regular Web Application settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=
# Auth0 quickstart name for the app's private session key. Generate with:
# openssl rand -hex 32
# Also the key material for encrypting a project's saved login-recipe
# secrets at rest (any password-type step in a login recipe, so AppMCP's
# "Authenticate" tool can sign in on an agent's behalf) — must be set for
# that feature to work, same as for Auth0 login sessions.
AUTH0_SECRET=
# Optional identifier of a custom Auth0 API. Leave blank for login-only sessions.
AUTH0_AUDIENCE=
AUTH0_CONNECTION=Username-Password-Authentication

# OpenAI-compatible project agent runtime
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Browser-facing app origin. Use the public HTTPS origin in production.
APP_BASE_URL=http://127.0.0.1:4310
# Optional comma-separated custom domains. Origins authorize browser requests;
# hosts authorize requests without an Origin header. Keep APP_BASE_URL canonical.
# APP_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# APP_ALLOWED_HOSTS=app.example.com,www.example.com
